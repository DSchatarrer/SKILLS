        "p": "probabilidades proyectadas",
        "tau": "umbral",
        "k": "soporte activo"
      },
      "assumptions": [
        "z es real finito",
        "último eje de longitud K>=1",
        "float64 para tests estrictos",
        "ordenación descendente",
        "puntos no diferenciables quedan fuera de gradcheck"
      ],
