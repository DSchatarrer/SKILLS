      "expression": "sparsemax(z) = argmin_{p>=0, Σp=1} ||p-z||² ; p_i=max(z_i-tau(z),0), tau=(Σ_{j<=k} z_(j)-1)/k, k=max{k:1+k*z_(k)>Σ_{j<=k} z_(j)}",
